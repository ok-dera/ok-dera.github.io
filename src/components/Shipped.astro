---
import { content } from '../content';

const { projects, alsoShipped, caseStudiesUrl } = content.shipped;
---

<section class="shipped" aria-label="Shipped work">
  <h2>Shipped Work</h2>
  <div class="grid">
    {projects.map((project) => (
      <article class="card">
        <div class="card-header">
          <h3>
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {project.name}
              <span class="sr-only"> (opens in new tab)</span>
              <span class="arrow" aria-hidden="true">&nearr;</span>
            </a>
          </h3>
        </div>
        <p class="description">{project.description}</p>
        <ul class="tags" aria-label={`Technologies used in ${project.name}`}>
          {project.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      </article>
    ))}
  </div>
  <div class="also-shipped">
    <p>
      Also shipped as sole developer: {alsoShipped.map((item, i) => (
        <>{i > 0 && <span class="dot" aria-hidden="true"> &middot; </span>}<strong>{item.name}</strong> <span class="note">({item.note})</span></>
      ))}
    </p>
    <a href={caseStudiesUrl} target="_blank" rel="noopener noreferrer" class="case-studies-link">
      View case studies
      <span class="sr-only"> (opens in new tab)</span>
      <span class="arrow" aria-hidden="true">&rarr;</span>
    </a>
  </div>
</section>

<style>
  .shipped {
    padding-bottom: var(--space-2xl);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-2xl);
  }

  h2 {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: var(--space-xl);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8125rem;
  }

  .grid {
    display: grid;
    gap: var(--space-lg);
  }

  .card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: var(--space-xl);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 24px rgba(74, 45, 122, 0.06);
  }

  .card-header {
    margin-bottom: var(--space-sm);
  }

  h3 {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 400;
  }

  h3 a {
    color: var(--color-text);
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }

  h3 a:hover {
    color: var(--color-accent);
  }

  .arrow {
    font-size: 0.875rem;
    opacity: 0.4;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  h3 a:hover .arrow {
    opacity: 1;
  }

  .description {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-bottom: var(--space-md);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
  }

  .tags li {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--color-accent);
    background-color: var(--color-accent-bg);
    padding: 3px 10px;
    border-radius: 100px;
  }

  .also-shipped {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .also-shipped p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-bottom: var(--space-md);
  }

  .also-shipped strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .note {
    color: var(--color-text-light);
  }

  .dot {
    color: var(--color-text-light);
  }

  .case-studies-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
  }

  .case-studies-link .arrow {
    font-size: 0.875rem;
    transition: transform 0.2s ease;
  }

  .case-studies-link:hover .arrow {
    transform: translateX(3px);
    opacity: 1;
  }
</style>
